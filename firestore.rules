rules_version = '2';

// 우리 사이 관계도 — Firestore 보안 규칙 (6단계)
// 앱 접속 키는 브라우저에 공개되는 구조라, 진짜 방어는 이 규칙이 한다.
//
//   graphs/{공유코드}             관계도: 이름, 방장 번호표(ownerUid), 만든 시각
//   graphs/{공유코드}/members/{id} 멤버: 이름, 생년월일, 태어난 시간, 추가한 사람(createdBy)
//
// 규칙 요약
//   - 번호표(익명 로그인)가 있어야 무엇이든 할 수 있다
//   - 관계도는 공유 코드를 아는 것 하나씩만 읽을 수 있다. 목록 통째 조회는 금지
//   - 관계도를 만들면 만든 사람이 방장이 된다(다른 사람을 방장으로 적을 수 없음)
//   - 멤버 추가: 누구나(대신 추가 포함). 단, '추가한 사람'은 반드시 본인 번호표
//   - 멤버 수정: 추가한 사람만. '추가한 사람' 칸은 바꿀 수 없음
//   - 멤버 삭제: 추가한 사람 또는 방장
//   - 이름 길이, 날짜·시간 형식을 서버에서도 검사
//
// 알고 감수하는 한계: 멤버 최대 10명은 화면에서만 막는다(규칙에서 개수 세기는 비용이 큼).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validGraph(d) {
      return d.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.ownerUid == request.auth.uid
        && d.createdAt == request.time;
    }

    function validMemberFields(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 12
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.birthTime == null
            || (d.birthTime is string && d.birthTime.matches('^[0-9]{2}:[0-9]{2}$')));
    }

    function graphOwner(code) {
      return get(/databases/$(database)/documents/graphs/$(code)).data.ownerUid;
    }

    match /graphs/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 8 && code.size() <= 40
        && validGraph(request.resource.data);
      // 관계도 이름 바꾸기·관계도 삭제 기능은 아직 없으므로 닫아 둔다
      allow update, delete: if false;

      match /members/{memberId} {
        // 공유 코드를 아는 관계도의 멤버만 읽을 수 있다(다른 관계도를 가로질러 찾는 조회는 규칙이 없어 거부됨)
        allow read: if signedIn();

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/graphs/$(code))
          && request.resource.data.keys().hasOnly(['name', 'birthDate', 'birthTime', 'createdBy', 'createdAt'])
          && validMemberFields(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if signedIn()
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'birthDate', 'birthTime', 'updatedAt'])
          && validMemberFields(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedIn()
          && (resource.data.createdBy == request.auth.uid
              || graphOwner(code) == request.auth.uid);
      }
    }
  }
}
